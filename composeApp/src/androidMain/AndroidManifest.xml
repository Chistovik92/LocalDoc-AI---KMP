<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Сеть — для веб-страниц, моделей и проверки обновлений. Файлы открываются через SAF,
         доступ ко всему хранилищу не нужен -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Плеер озвучки в шторке: чтение продолжается, когда приложение свёрнуто -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Голосовое управление чтением («дальше», «пауза»): выключено по умолчанию, микрофон запрашивается при включении -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Обновление: приложение само скачивает APK и открывает системную установку поверх текущей версии -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Сканирование всего устройства в поисках книг: разрешение выдаёт сам пользователь в настройках («Доступ ко всем файлам») -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 8–9: то же сканирование делает обычное разрешение на чтение хранилища (с Android 10 его заменяют выбор папки и «Доступ ко всем файлам») -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Android 11+: без этого список сторонних TTS-движков (RHVoice, sherpa-onnx…) пуст -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".LocalDocApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="LocalDoc AI"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <!-- Перехват ссылок и выделенного текста из браузеров -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- «Поделиться» файлом книги -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
            </intent-filter>

            <!-- Открытие книг из проводника. Без BROWSABLE: веб-страница не должна мочь запустить импорт локального файла -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
            </intent-filter>

            <!-- Действия виджета и уведомления: localdoc://continue | play | open-file | open-url -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="localdoc" />
            </intent-filter>

            <!-- Основной launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Отдаёт скачанный APK обновления системному установщику -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!-- Плеер озвучки в шторке (MediaSession + уведомление MediaStyle) -->
        <service
            android:name=".player.ReadAloudService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Виджет рабочего стола: плеер, «Открыть книгу», «Ссылка» -->
        <receiver
            android:name=".player.ReaderWidgetProvider"
            android:exported="false"
            android:label="LocalDoc AI — плеер">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_info" />
        </receiver>
    </application>
</manifest>
