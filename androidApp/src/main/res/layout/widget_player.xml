<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="LocalDoc AI"
        android:textColor="@color/widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Откройте книгу или веб-страницу"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Назад"
            android:scaleType="center"
            android:src="@drawable/ic_player_previous"
            android:tint="@color/widget_text" />

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_play_background"
            android:contentDescription="Читать или пауза"
            android:scaleType="center"
            android:src="@drawable/ic_player_play"
            android:tint="@color/widget_on_primary" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Вперёд"
            android:scaleType="center"
            android:src="@drawable/ic_player_next"
            android:tint="@color/widget_text" />

        <ImageButton
            android:id="@+id/widget_stop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Стоп"
            android:scaleType="center"
            android:src="@drawable/ic_player_stop"
            android:tint="@color/widget_text" />

        <!-- Распорка: в RemoteViews нельзя использовать View/Space — виджет не загружается -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/widget_open_book"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_button_background"
            android:contentDescription="Открыть книгу"
            android:scaleType="center"
            android:src="@drawable/ic_widget_book"
            android:tint="@color/widget_text" />

        <ImageButton
            android:id="@+id/widget_open_url"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button_background"
            android:contentDescription="Открыть ссылку"
            android:scaleType="center"
            android:src="@drawable/ic_widget_link"
            android:tint="@color/widget_text" />

    </LinearLayout>
</LinearLayout>
